{
  "name": "raccoonhouse-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "PEER_REGISTRY",
        "class_name": "PeerRegistry"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "TRANSFERS",
      "bucket_name": "raccoonhouse-transfers"
    }
  ],
  "d1_databases": [
    {
      "binding": "MODELS_DB",
      "database_name": "raccoonhouse-models",
      "database_id": "696a7018-3b52-402d-803a-d2aafccddd1a"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PeerRegistry"]
    }
  ]
}
