# Loaded by Vite when building with --mode actor (see package.json's
# build:actor script). Read by src/buildVariant.ts to hide the
# separation/GPU/model-browser/power-share UI that has no working backend
# in the actor-lite install (see build-backend.py's --actor flag) — team
# sync and actor-audio upload/download stay fully intact either way.
VITE_BUILD_VARIANT=actor
